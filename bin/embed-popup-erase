#!/usr/bin/env bash
# embed-popup-erase — mass-erase chip, with confirmation.

dir="$PWD"
while [[ "$dir" != "/" && "$dir" != "$HOME" ]]; do
    if [[ -f "$dir/Makefile" ]]; then
        cd "$dir" || exit 1
        break
    fi
    dir="$(dirname "$dir")"
done

if [[ ! -f "Makefile" ]]; then
    echo "ERROR: no Makefile found"
    read -r
    exit 1
fi

echo "=========================================="
echo "  This will MASS-ERASE the connected chip."
echo "=========================================="
echo
read -rp "Type 'yes' to confirm: " answer
if [[ "$answer" != "yes" ]]; then
    echo "Aborted."
    read -r
    exit 0
fi

echo
make erase
echo
echo "── press Enter to close ──"
read -r || true
