#!/usr/bin/env bash
#
# embed — embedded systems project & workflow launcher
#
# Usage:
#   embed new <project> <board> [--os=bare|freertos]
#   embed open <project>
#   embed list projects | embed list boards
#   embed flash <project>
#   embed help
#
set -euo pipefail

# ─── Paths ───────────────────────────────────────────────────────────────────
EMBED_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BOARDS_DIR="$EMBED_ROOT/boards"
TEMPLATES_DIR="$EMBED_ROOT/templates"
PROJECTS_DIR="${EMBED_PROJECTS_DIR:-$HOME/work/embedded_systems/projects}"
SESSION_SCRIPT="$EMBED_ROOT/tmux/embed-session.sh"

# ─── Colors ──────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YLW=$'\e[33m'
    C_BLU=$'\e[34m'; C_DIM=$'\e[2m';  C_RST=$'\e[0m'
else
    C_RED=''; C_GRN=''; C_YLW=''; C_BLU=''; C_DIM=''; C_RST=''
fi
say()   { printf '%s▸%s %s\n' "$C_BLU" "$C_RST" "$*"; }
ok()    { printf '%s✓%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn()  { printf '%s!%s %s\n' "$C_YLW" "$C_RST" "$*" >&2; }
die()   { printf '%s✗%s %s\n' "$C_RED" "$C_RST" "$*" >&2; exit 1; }

# ─── Helpers ─────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
${C_BLU}embed${C_RST} — embedded systems project launcher

${C_YLW}Usage:${C_RST}
  embed new <project> <board> [--os=bare|freertos]
  embed new <project> <board> --assignment [--course="ECEN 5613"]
  embed open <project>
  embed list projects | embed list boards
  embed flash <project>
  embed flags [project]       write compile_flags.txt (clangd include paths)
  embed help

${C_YLW}Modes:${C_RST}
  (default)      full template: working Makefile, linker script, startup, blinky
  --assignment   folders + header-only files; you write every line of code

${C_YLW}Examples:${C_RST}
  embed new blink nucleo-l476rg
  embed new rtos-demo nucleo-l476rg --os=freertos
  embed new lab3-stm32 stm32f411e-disco --assignment --course="ECEN 5613"
  embed open blink
  embed list boards

${C_YLW}Env:${C_RST}
  EMBED_PROJECTS_DIR   where projects live (default: $HOME/work/embedded_systems/projects)
  EMBED_AUTHOR         author name for assignment headers (default: git user.name)
EOF
}

load_board() {
    local board="$1"
    local conf="$BOARDS_DIR/$board.conf"
    [[ -f "$conf" ]] || die "Unknown board: $board. Run 'embed list boards' to see options."
    # shellcheck disable=SC1090
    source "$conf"
}

# Expand @VAR@ markers in a file using currently-set env vars.
# Much safer than envsubst because we only touch @TOKENS@ not $VAR.
render_template() {
    local src="$1" dst="$2"
    # Read whole file, do sed substitutions
    local content
    content="$(cat "$src")"
    # Every var we might substitute:
    local vars=(
        PROJECT BOARD_ID BOARD_NAME MCU
        CPU FPU FLOAT_ABI
        FLASH_ORIGIN FLASH_SIZE RAM_ORIGIN RAM_SIZE
        TOOLCHAIN_PREFIX
        OPENOCD_CFG OPENOCD_CHIP_FAMILY
        SERIAL_PORT SERIAL_BAUD
        USER_LED_PORT USER_LED_PIN
        OS_NAME EMBED_ROOT
    )
    for v in "${vars[@]}"; do
        local val="${!v:-}"
        # Escape for sed replacement (handle / and &)
        val="${val//\\/\\\\}"; val="${val//\//\\/}"; val="${val//&/\\&}"
        content="$(printf '%s' "$content" | sed "s/@${v}@/${val}/g")"
    done
    printf '%s\n' "$content" > "$dst"
}

# ─── Subcommands ─────────────────────────────────────────────────────────────

cmd_list() {
    local what="${1:-projects}"
    case "$what" in
        boards)
            printf "%s\n" "Available boards:"
            for f in "$BOARDS_DIR"/*.conf; do
                [[ -f "$f" ]] || continue
                (
                    # shellcheck disable=SC1090
                    source "$f"
                    note=""
                    [[ "${TEMPLATES:-}" = "assignment" ]] && note="  (--assignment only)"
                    printf "  %-20s %s (%s)%s\n" "$BOARD_ID" "$BOARD_NAME" "$MCU" "$note"
                )
            done
            ;;
        projects)
            printf "%s\n" "Projects in $PROJECTS_DIR:"
            if [[ -d "$PROJECTS_DIR" ]]; then
                for d in "$PROJECTS_DIR"/*/; do
                    [[ -d "$d" ]] || continue
                    local name
                    name="$(basename "$d")"
                    local board="?" mode="template"
                    [[ -f "$d/.embed/board.conf" ]] && \
                        board="$(grep -E '^BOARD_ID=' "$d/.embed/board.conf" | cut -d'"' -f2)"
                    if grep -q '^MODE="assignment"' "$d/.embed/project.conf" 2>/dev/null; then
                        mode="assignment"
                    fi
                    printf "  %-25s [%s] %s\n" "$name" "$board" "$mode"
                done
            else
                warn "Projects dir does not exist yet: $PROJECTS_DIR"
            fi
            ;;
        *)
            die "Unknown list target: $what (use 'projects' or 'boards')"
            ;;
    esac
}

cmd_new() {
    local project="${1:-}" board="${2:-}"; shift 2 || true
    local os="bare" mode="template" course=""
    for arg in "$@"; do
        case "$arg" in
            --os=*)       os="${arg#--os=}" ;;
            --assignment) mode="assignment" ;;
            --course=*)   course="${arg#--course=}" ;;
            *) die "Unknown arg: $arg" ;;
        esac
    done

    [[ -n "$project" ]] || die "Project name required. See 'embed help'."
    [[ -n "$board"   ]] || die "Board required. See 'embed list boards'."
    [[ "$os" =~ ^(bare|freertos)$ ]] || die "--os must be 'bare' or 'freertos'"
    if [[ "$mode" = "assignment" && "$os" != "bare" ]]; then
        die "--assignment and --os=freertos can't be combined (assignment mode generates no code)"
    fi

    load_board "$board"

    if [[ "$mode" = "template" && "${TEMPLATES:-}" = "assignment" ]]; then
        die "$BOARD_NAME has no full template yet. Use: embed new $project $board --assignment"
    fi

    local dest="$PROJECTS_DIR/$project"
    [[ ! -e "$dest" ]] || die "Project already exists: $dest"

    if [[ "$mode" = "assignment" ]]; then
        scaffold_assignment "$project" "$board" "$dest" "$course"
        ok "Assignment project created at: $dest"
        say "Launching tmux session..."
        launch_session "$project" "$dest"
        return
    fi

    local tpl_dir="$TEMPLATES_DIR/$([ "$os" = "freertos" ] && echo freertos || echo bare-metal)"
    [[ -d "$tpl_dir" ]] || die "Template not found: $tpl_dir"

    say "Creating project '$project' (board=$BOARD_NAME, os=$os)"
    mkdir -p "$dest"
    PROJECT="$project"
    OS_NAME="$os"
    export PROJECT BOARD_ID BOARD_NAME MCU CPU FPU FLOAT_ABI \
           FLASH_ORIGIN FLASH_SIZE RAM_ORIGIN RAM_SIZE \
           TOOLCHAIN_PREFIX OPENOCD_CFG OPENOCD_CHIP_FAMILY \
           SERIAL_PORT SERIAL_BAUD USER_LED_PORT USER_LED_PIN \
           OS_NAME EMBED_ROOT

    # Copy/render template tree
    (
        cd "$tpl_dir"
        find . -type f | while read -r f; do
            local rel="${f#./}"
            local target="$dest/$rel"
            # Strip .in suffix from output filename (templated files)
            if [[ "$rel" == *.in ]]; then
                target="$dest/${rel%.in}"
            fi
            mkdir -p "$(dirname "$target")"
            if [[ "$rel" == *.in ]]; then
                render_template "$f" "$target"
            else
                cp "$f" "$target"
            fi
            # Preserve executable bit (don't let a false test trip set -e)
            if [[ -x "$f" ]]; then chmod +x "$target"; fi
        done
        true  # guarantee subshell exits 0
    )

    # Stash the board conf in the project so popups/scripts can read it
    cp "$BOARDS_DIR/$board.conf" "$dest/.embed/board.conf"
    echo "PROJECT=\"$project\"" > "$dest/.embed/project.conf"
    echo "OS=\"$os\""          >> "$dest/.embed/project.conf"
    echo "MODE=\"template\""   >> "$dest/.embed/project.conf"

    # Make .embed scripts executable
    chmod +x "$dest"/.embed/*.sh 2>/dev/null || true
    write_compile_flags "$dest"

    # If FreeRTOS, fetch kernel
    if [[ "$os" = "freertos" ]]; then
        fetch_freertos "$dest"
    fi

    ok "Project created at: $dest"
    say "Launching tmux session..."
    launch_session "$project" "$dest"
}

# ─── Assignment mode ─────────────────────────────────────────────────────────
# Creates folders and files that contain ONLY a comment header. No code, no
# outline. Tooling files (.embed/, .clang-format, .gitignore) are copied so the
# tmux popups, serial monitor and clangd keep working.

# write_header <file> <style: c|hash> <project> <course> <author>
write_header() {
    local file="$1" style="$2" project="$3" course="$4" author="$5"
    local name; name="$(basename "$file")"
    local date; date="$(date +%Y-%m-%d)"
    local lines=(
        "File        : $name"
        "Project     : $project"
        "Board       : $BOARD_NAME ($MCU)"
        "Author      : $author"
        "Course      : $course"
        "Date        : $date"
        ""
        "Description :"
        ""
        "\"I have neither given nor received unauthorized assistance.\""
    )
    mkdir -p "$(dirname "$file")"
    {
        if [[ "$style" = "c" ]]; then
            echo "/*"
            for l in "${lines[@]}"; do
                if [[ -z "$l" ]]; then echo " *"; else echo " * $l"; fi
            done
            echo " */"
        else
            for l in "${lines[@]}"; do
                if [[ -z "$l" ]]; then echo "#"; else echo "# $l"; fi
            done
        fi
        echo
    } > "$file"
}

# ─── clangd flags ────────────────────────────────────────────────────────────
# compile_flags.txt tells clangd the target, CPU and include paths, so
# #include "x.h" from inc/ resolves in the editor without depending on the
# Makefile. clangd prefers compile_commands.json when that exists.
# Uses the board vars currently loaded (load_board or a project's board.conf).
write_compile_flags() {
    local dest="$1"
    local newlib_inc
    newlib_inc="$("${TOOLCHAIN_PREFIX}gcc" -print-sysroot 2>/dev/null || true)"
    if [[ -n "$newlib_inc" && -d "$newlib_inc/include" ]]; then
        newlib_inc="$newlib_inc/include"
    else
        newlib_inc="/usr/lib/arm-none-eabi/include"
    fi
    {
        echo "--target=arm-none-eabi"
        echo "-mcpu=$CPU"
        echo "-mthumb"
        if [[ "${FPU:-none}" != "none" ]]; then
            echo "-mfpu=$FPU"
            echo "-mfloat-abi=$FLOAT_ABI"
        fi
        echo "-std=gnu11"
        echo "-ffreestanding"
        echo "-Wall"
        echo "-Iinc"
        echo "-Idrivers"
        echo "-Isrc"
        echo "-Iconfig"
        echo "-isystem$newlib_inc"
    } > "$dest/compile_flags.txt"
}

# embed flags [project] — (re)write compile_flags.txt for an existing project.
# With no argument, uses the project containing the current directory.
cmd_flags() {
    local dest=""
    if [[ -n "${1:-}" ]]; then
        dest="$PROJECTS_DIR/$1"
    else
        local dir="$PWD"
        while [[ "$dir" != "/" ]]; do
            if [[ -f "$dir/.embed/board.conf" ]]; then dest="$dir"; break; fi
            dir="$(dirname "$dir")"
        done
    fi
    [[ -n "$dest" && -f "$dest/.embed/board.conf" ]] || \
        die "Not inside an embed project (no .embed/board.conf). Pass a project name."
    # shellcheck disable=SC1091
    source "$dest/.embed/board.conf"
    write_compile_flags "$dest"
    ok "Wrote $dest/compile_flags.txt"
    if [[ -f "$dest/compile_commands.json" ]]; then
        warn "compile_commands.json exists and takes priority over compile_flags.txt."
        warn "If includes still fail, regenerate it (<leader>mc) or delete it."
    fi
    say "In nvim: :LspRestart"
}

scaffold_assignment() {
    local project="$1" board="$2" dest="$3" course="$4"
    local author="${EMBED_AUTHOR:-$(git config --global user.name 2>/dev/null || true)}"
    author="${author:-$USER}"

    say "Creating assignment project '$project' (board=$BOARD_NAME)"
    mkdir -p "$dest"/{src,inc,drivers,startup,linker,.embed}

    # Header-only source files: you write everything below the header
    write_header "$dest/Makefile"            hash "$project" "$course" "$author"
    write_header "$dest/linker/linker.ld"    c    "$project" "$course" "$author"
    write_header "$dest/startup/startup.s"   c    "$project" "$course" "$author"
    write_header "$dest/src/main.c"          c    "$project" "$course" "$author"

    # Tooling only (no code): popups, formatter, ignore rules
    local tpl="$TEMPLATES_DIR/bare-metal"
    cp "$tpl/.embed/"*.sh "$dest/.embed/"
    chmod +x "$dest/.embed/"*.sh
    cp "$tpl/.clang-format" "$dest/.clang-format"
    cp "$tpl/.gitignore"    "$dest/.gitignore"
    write_compile_flags "$dest"

    cp "$BOARDS_DIR/$board.conf" "$dest/.embed/board.conf"
    {
        echo "PROJECT=\"$project\""
        echo "OS=\"bare\""
        echo "MODE=\"assignment\""
    } > "$dest/.embed/project.conf"

    cat > "$dest/README.md" <<EOF
# $project

Assignment project on **$BOARD_NAME** ($MCU). Every line of code is yours.

## Makefile targets the workflow calls

The tmux popups and nvim commands run \`make <target>\`. Provide these
targets in your Makefile as you build it up:

| Target    | Used by                          |
|-----------|----------------------------------|
| \`all\`     | \`C-s B\`, \`<leader>mb\`            |
| \`flash\`   | \`C-s F\`, \`<leader>mf\`            |
| \`erase\`   | \`C-s E\`, \`<leader>me\`            |
| \`openocd\` | \`<leader>md\` (debug window, top)   |
| \`debug\`   | \`<leader>md\` (debug window, bottom)|
| \`clean\`   | your own use                     |

Until \`openocd\` and \`debug\` exist, the debug window (\`C-s 2\`) has the raw
commands pre-typed, so debugging works from day one.

## Board facts

- Flash: $FLASH_ORIGIN, $FLASH_SIZE
- RAM:   $RAM_ORIGIN, $RAM_SIZE
- CPU:   $CPU, FPU $FPU (float ABI $FLOAT_ABI)
- OpenOCD config: $OPENOCD_CFG
- Serial: $SERIAL_PORT @ $SERIAL_BAUD (override in .embed/board.conf)
EOF
}

cmd_open() {
    local project="${1:-}"
    [[ -n "$project" ]] || die "Project name required"
    local dest="$PROJECTS_DIR/$project"
    [[ -d "$dest" ]] || die "Project not found: $dest"
    launch_session "$project" "$dest"
}

cmd_flash() {
    local project="${1:-}"
    [[ -n "$project" ]] || die "Project name required"
    local dest="$PROJECTS_DIR/$project"
    [[ -d "$dest" ]] || die "Project not found: $dest"
    ( cd "$dest" && make flash )
}

launch_session() {
    local project="$1" dest="$2"
    if [[ "${EMBED_SKIP_LAUNCH:-0}" = "1" ]]; then
        say "(EMBED_SKIP_LAUNCH=1; would launch tmux session '$project' in $dest)"
        return 0
    fi
    [[ -x "$SESSION_SCRIPT" ]] || die "Session script missing or not executable: $SESSION_SCRIPT"
    "$SESSION_SCRIPT" "$project" "$dest"
}

FREERTOS_TAG="V11.1.0"

fetch_freertos() {
    local dest="$1"
    local kernel_dir="$dest/middleware/FreeRTOS-Kernel"
    say "Fetching FreeRTOS-Kernel $FREERTOS_TAG into middleware/ (shallow clone)"
    if ! command -v git >/dev/null 2>&1; then
        warn "git not installed — skipping FreeRTOS kernel fetch"
        warn "Install with: sudo apt install git"
        return
    fi
    mkdir -p "$(dirname "$kernel_dir")"
    if git clone --depth 1 --branch "$FREERTOS_TAG" \
        https://github.com/FreeRTOS/FreeRTOS-Kernel.git \
        "$kernel_dir" 2>&1 | sed 's/^/    /'; then
        ok "FreeRTOS-Kernel $FREERTOS_TAG fetched"
    else
        warn "FreeRTOS kernel fetch failed. You can retry manually:"
        warn "  git clone --depth 1 --branch $FREERTOS_TAG https://github.com/FreeRTOS/FreeRTOS-Kernel.git $kernel_dir"
    fi
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
main() {
    local sub="${1:-help}"; shift || true
    case "$sub" in
        new)    cmd_new   "$@" ;;
        open)   cmd_open  "$@" ;;
        list)   cmd_list  "$@" ;;
        flash)  cmd_flash "$@" ;;
        flags)  cmd_flags "$@" ;;
        help|-h|--help) usage ;;
        *) usage; die "Unknown subcommand: $sub" ;;
    esac
}
main "$@"
