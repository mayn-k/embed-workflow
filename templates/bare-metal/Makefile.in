# Makefile — @PROJECT@ on @BOARD_NAME@ (@MCU@)
# Generated by embed. Edit freely; it won't be regenerated.
#
# Common targets:
#   make             build elf/bin/hex (+ size)
#   make flash       flash via OpenOCD + reset
#   make erase       mass-erase chip
#   make reset       reset MCU
#   make openocd     start OpenOCD server (run in debug pane)
#   make debug       start GDB, connect to OpenOCD, load, break at main
#   make monitor     tio serial monitor
#   make size        section size breakdown
#   make dump        full disassembly to bin/*.lst
#   make ccdb        regenerate compile_commands.json (needs `bear`)
#   make clean       wipe build artifacts

# ─── Toolchain ───────────────────────────────────────────────────────────────
TOOLCHAIN_PREFIX ?= @TOOLCHAIN_PREFIX@
CC       := $(TOOLCHAIN_PREFIX)gcc
OBJCOPY  := $(TOOLCHAIN_PREFIX)objcopy
OBJDUMP  := $(TOOLCHAIN_PREFIX)objdump
SIZE     := $(TOOLCHAIN_PREFIX)size
GDB      := $(TOOLCHAIN_PREFIX)gdb

# ─── Project ─────────────────────────────────────────────────────────────────
PROJ_NAME := $(notdir $(CURDIR))

# ─── Architecture flags ──────────────────────────────────────────────────────
CPU_FLAGS  := -mcpu=@CPU@ -mthumb
FPU_FLAGS  := -mfpu=@FPU@ -mfloat-abi=@FLOAT_ABI@
ARCH_FLAGS := $(CPU_FLAGS) $(FPU_FLAGS)

# ─── Paths ───────────────────────────────────────────────────────────────────
SRC_DIRS      := src startup
INC_DIRS      := inc
BUILD_DIR     := build
BIN_DIR       := bin
LINKER_SCRIPT := linker/linker.ld

# ─── Source discovery ────────────────────────────────────────────────────────
SRCS_C := $(foreach d,$(SRC_DIRS),$(wildcard $(d)/*.c))
SRCS_S := $(foreach d,$(SRC_DIRS),$(wildcard $(d)/*.s))
OBJS   := $(SRCS_C:%.c=$(BUILD_DIR)/%.o) $(SRCS_S:%.s=$(BUILD_DIR)/%.o)
DEPS   := $(OBJS:.o=.d)

ELF := $(BIN_DIR)/$(PROJ_NAME).elf
BIN := $(BIN_DIR)/$(PROJ_NAME).bin
HEX := $(BIN_DIR)/$(PROJ_NAME).hex
MAP := $(BIN_DIR)/$(PROJ_NAME).map
LST := $(BIN_DIR)/$(PROJ_NAME).lst

# ─── Compile / link flags ────────────────────────────────────────────────────
INCLUDES := $(addprefix -I,$(INC_DIRS))

# Warnings we actually want on by default for embedded code
WARN_FLAGS := -Wall -Wextra -Wshadow -Wdouble-promotion \
              -Wformat=2 -Wformat-truncation -Wundef \
              -fno-common

COMMON_FLAGS := $(ARCH_FLAGS) $(INCLUDES) $(WARN_FLAGS) \
                -ggdb -O0 \
                -ffunction-sections -fdata-sections \
                -MMD -MP

CFLAGS   := $(COMMON_FLAGS) -std=gnu11
ASFLAGS  := $(ARCH_FLAGS) -x assembler-with-cpp
LDFLAGS  := $(ARCH_FLAGS) \
            -T$(LINKER_SCRIPT) \
            -Wl,-Map=$(MAP),--gc-sections,--print-memory-usage \
            -nostartfiles \
            --specs=nano.specs --specs=nosys.specs

# ─── Flash / debug config ────────────────────────────────────────────────────
OPENOCD      := openocd
OPENOCD_CFG  := @OPENOCD_CFG@
CHIP_FAMILY  := @OPENOCD_CHIP_FAMILY@
GDB_PORT     := 3333
TELNET_PORT  := 4444
SERIAL_PORT  := @SERIAL_PORT@
SERIAL_BAUD  := @SERIAL_BAUD@

# ─── Default target ──────────────────────────────────────────────────────────
.DEFAULT_GOAL := all
.PHONY: all clean flash erase reset openocd gdb debug monitor size dump ccdb help

all: $(BIN) $(HEX) size

# ─── Compile / link ──────────────────────────────────────────────────────────
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@printf '  CC   %s\n' $<
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	@printf '  AS   %s\n' $<
	@$(CC) $(ASFLAGS) -c $< -o $@

$(ELF): $(OBJS) $(LINKER_SCRIPT)
	@mkdir -p $(BIN_DIR)
	@printf '  LD   %s\n' $@
	@$(CC) $(OBJS) $(LDFLAGS) -o $@

$(BIN): $(ELF)
	@printf '  BIN  %s\n' $@
	@$(OBJCOPY) -O binary $< $@

$(HEX): $(ELF)
	@printf '  HEX  %s\n' $@
	@$(OBJCOPY) -O ihex $< $@

size: $(ELF)
	@echo
	@$(SIZE) $<
	@echo

dump: $(ELF)
	$(OBJDUMP) -D -S $< > $(LST)
	@echo "Disassembly written to $(LST)"

# ─── Flash via OpenOCD ───────────────────────────────────────────────────────
flash: $(ELF)
	$(OPENOCD) -f $(OPENOCD_CFG) \
	    -c "program $< verify reset exit"

erase:
	$(OPENOCD) -f $(OPENOCD_CFG) \
	    -c "init; reset halt; $(CHIP_FAMILY) mass_erase 0; exit"

reset:
	$(OPENOCD) -f $(OPENOCD_CFG) \
	    -c "init; reset; exit"

# ─── Debug ───────────────────────────────────────────────────────────────────
# Start OpenOCD server in the foreground. Run this in your debug-window top
# pane — it stays up until you Ctrl-C.
openocd:
	$(OPENOCD) -f $(OPENOCD_CFG) \
	    -c "gdb_port $(GDB_PORT); telnet_port $(TELNET_PORT)"

# Start GDB, connect to OpenOCD, load fresh binary, break at main.
# Run this in the bottom pane of the debug window AFTER `make openocd` is up.
debug gdb: $(ELF)
	$(GDB) $< \
	    -ex "target extended-remote localhost:$(GDB_PORT)" \
	    -ex "monitor reset halt" \
	    -ex "load" \
	    -ex "monitor reset halt" \
	    -ex "tbreak main" \
	    -ex "continue"

# ─── Serial monitor ──────────────────────────────────────────────────────────
monitor:
	@command -v tio >/dev/null || { echo "tio not installed: sudo apt install tio"; exit 1; }
	tio $(SERIAL_PORT) -b $(SERIAL_BAUD)

# ─── clangd compile_commands.json ────────────────────────────────────────────
ccdb compile_commands.json:
	@command -v bear >/dev/null || { echo "bear not installed: sudo apt install bear"; exit 1; }
	bear --output compile_commands.json -- $(MAKE) -B

# ─── Cleanup ─────────────────────────────────────────────────────────────────
clean:
	rm -rf $(BUILD_DIR) $(BIN_DIR) compile_commands.json

help:
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# Include auto-generated dependency files (silently if missing)
-include $(DEPS)
