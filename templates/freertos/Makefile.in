# Makefile — @PROJECT@ (FreeRTOS) on @BOARD_NAME@ (@MCU@)
# Generated by embed. Edit freely; it won't be regenerated.

# ─── Toolchain ───────────────────────────────────────────────────────────────
TOOLCHAIN_PREFIX ?= @TOOLCHAIN_PREFIX@
CC       := $(TOOLCHAIN_PREFIX)gcc
OBJCOPY  := $(TOOLCHAIN_PREFIX)objcopy
OBJDUMP  := $(TOOLCHAIN_PREFIX)objdump
SIZE     := $(TOOLCHAIN_PREFIX)size
GDB      := $(TOOLCHAIN_PREFIX)gdb

# ─── Project ─────────────────────────────────────────────────────────────────
PROJ_NAME := $(notdir $(CURDIR))

# ─── Architecture ────────────────────────────────────────────────────────────
CPU_FLAGS  := -mcpu=@CPU@ -mthumb
FPU_FLAGS  := -mfpu=@FPU@ -mfloat-abi=@FLOAT_ABI@
ARCH_FLAGS := $(CPU_FLAGS) $(FPU_FLAGS)

# ─── Paths ───────────────────────────────────────────────────────────────────
BUILD_DIR     := build
BIN_DIR       := bin
LINKER_SCRIPT := linker/linker.ld

FREERTOS_DIR  := middleware/FreeRTOS-Kernel
FREERTOS_PORT := $(FREERTOS_DIR)/portable/GCC/ARM_CM4F
FREERTOS_MEM  := $(FREERTOS_DIR)/portable/MemMang

# Your code
APP_SRC_DIRS := src startup
APP_INC_DIRS := inc config

# FreeRTOS sources (kernel + Cortex-M4F port + heap_4 allocator)
FREERTOS_SRCS := \
    $(FREERTOS_DIR)/tasks.c \
    $(FREERTOS_DIR)/queue.c \
    $(FREERTOS_DIR)/list.c  \
    $(FREERTOS_DIR)/timers.c \
    $(FREERTOS_DIR)/event_groups.c \
    $(FREERTOS_DIR)/stream_buffer.c \
    $(FREERTOS_PORT)/port.c \
    $(FREERTOS_MEM)/heap_4.c

FREERTOS_INCS := \
    $(FREERTOS_DIR)/include \
    $(FREERTOS_PORT)

# ─── Source discovery ────────────────────────────────────────────────────────
APP_SRCS_C := $(foreach d,$(APP_SRC_DIRS),$(wildcard $(d)/*.c))
APP_SRCS_S := $(foreach d,$(APP_SRC_DIRS),$(wildcard $(d)/*.s))

ALL_SRCS_C := $(APP_SRCS_C) $(FREERTOS_SRCS)

OBJS := $(ALL_SRCS_C:%.c=$(BUILD_DIR)/%.o) $(APP_SRCS_S:%.s=$(BUILD_DIR)/%.o)
DEPS := $(OBJS:.o=.d)

ELF := $(BIN_DIR)/$(PROJ_NAME).elf
BIN := $(BIN_DIR)/$(PROJ_NAME).bin
HEX := $(BIN_DIR)/$(PROJ_NAME).hex
MAP := $(BIN_DIR)/$(PROJ_NAME).map
LST := $(BIN_DIR)/$(PROJ_NAME).lst

# ─── Flags ───────────────────────────────────────────────────────────────────
INCLUDES := $(addprefix -I,$(APP_INC_DIRS) $(FREERTOS_INCS))

WARN_FLAGS := -Wall -Wextra -Wshadow -Wdouble-promotion \
              -Wformat=2 -Wundef -fno-common

COMMON_FLAGS := $(ARCH_FLAGS) $(INCLUDES) $(WARN_FLAGS) \
                -ggdb -O0 \
                -ffunction-sections -fdata-sections \
                -MMD -MP

CFLAGS   := $(COMMON_FLAGS) -std=gnu11
ASFLAGS  := $(ARCH_FLAGS) -x assembler-with-cpp
LDFLAGS  := $(ARCH_FLAGS) \
            -T$(LINKER_SCRIPT) \
            -Wl,-Map=$(MAP),--gc-sections,--print-memory-usage \
            -nostartfiles \
            --specs=nano.specs --specs=nosys.specs

# ─── Flash / debug config ────────────────────────────────────────────────────
OPENOCD      := openocd
OPENOCD_CFG  := @OPENOCD_CFG@
CHIP_FAMILY  := @OPENOCD_CHIP_FAMILY@
GDB_PORT     := 3333
TELNET_PORT  := 4444
SERIAL_PORT  := @SERIAL_PORT@
SERIAL_BAUD  := @SERIAL_BAUD@

# ─── Targets ─────────────────────────────────────────────────────────────────
.DEFAULT_GOAL := all
.PHONY: all clean flash erase reset openocd gdb debug monitor size dump ccdb help kernel-check

all: kernel-check $(BIN) $(HEX) size

kernel-check:
	@[ -d "$(FREERTOS_DIR)" ] || { \
	    echo "ERROR: FreeRTOS-Kernel not found at $(FREERTOS_DIR)"; \
	    echo "Run: embed fetch-kernel $(PROJ_NAME)"; \
	    echo "  or: git clone --depth 1 --branch V11.1.0 https://github.com/FreeRTOS/FreeRTOS-Kernel.git $(FREERTOS_DIR)"; \
	    exit 1; }

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@printf '  CC   %s\n' $<
	@$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	@printf '  AS   %s\n' $<
	@$(CC) $(ASFLAGS) -c $< -o $@

$(ELF): $(OBJS) $(LINKER_SCRIPT)
	@mkdir -p $(BIN_DIR)
	@printf '  LD   %s\n' $@
	@$(CC) $(OBJS) $(LDFLAGS) -o $@

$(BIN): $(ELF)
	@printf '  BIN  %s\n' $@
	@$(OBJCOPY) -O binary $< $@

$(HEX): $(ELF)
	@printf '  HEX  %s\n' $@
	@$(OBJCOPY) -O ihex $< $@

size: $(ELF)
	@echo
	@$(SIZE) $<
	@echo

dump: $(ELF)
	$(OBJDUMP) -D -S $< > $(LST)
	@echo "Disassembly written to $(LST)"

flash: $(ELF)
	$(OPENOCD) -f $(OPENOCD_CFG) -c "program $< verify reset exit"

erase:
	$(OPENOCD) -f $(OPENOCD_CFG) -c "init; reset halt; $(CHIP_FAMILY) mass_erase 0; exit"

reset:
	$(OPENOCD) -f $(OPENOCD_CFG) -c "init; reset; exit"

openocd:
	$(OPENOCD) -f $(OPENOCD_CFG) -c "gdb_port $(GDB_PORT); telnet_port $(TELNET_PORT)"

debug gdb: $(ELF)
	$(GDB) $< \
	    -ex "target extended-remote localhost:$(GDB_PORT)" \
	    -ex "monitor reset halt" \
	    -ex "load" \
	    -ex "monitor reset halt" \
	    -ex "tbreak main" \
	    -ex "continue"

monitor:
	@command -v tio >/dev/null || { echo "tio not installed: sudo apt install tio"; exit 1; }
	tio $(SERIAL_PORT) -b $(SERIAL_BAUD)

ccdb compile_commands.json:
	@command -v bear >/dev/null || { echo "bear not installed: sudo apt install bear"; exit 1; }
	bear --output compile_commands.json -- $(MAKE) -B

clean:
	rm -rf $(BUILD_DIR) $(BIN_DIR) compile_commands.json

-include $(DEPS)
